rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validGoal(goal) {
      return goal is string
        && goal in ['weight_loss', 'muscle_gain', 'maintenance', 'endurance'];
    }
    function validCategory(category) {
      return category is string
        && category in ['chest', 'back', 'legs', 'arms', 'shoulders', 'abs', 'cardio', 'full_body'];
    }
    function validProfile(d) {
      return d.keys().hasAll(['name', 'email', 'age', 'height', 'weight', 'goal', 'createdAt'])
        && d.keys().hasOnly(['name', 'email', 'age', 'height', 'weight', 'goal', 'createdAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.email is string && d.email.size() > 0 && d.email.size() <= 254
        && d.email == request.auth.token.get('email', '')
        && d.age is int && (d.age == 0 || (d.age >= 14 && d.age <= 100))
        && d.height is number && (d.height == 0 || (d.height >= 100 && d.height <= 250))
        && d.weight is number && (d.weight == 0 || (d.weight >= 20 && d.weight <= 400))
        && validGoal(d.goal)
        && d.createdAt is timestamp;
    }
    function profileExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.email == resource.data.email;
      allow delete: if false;

      match /completedWorkouts/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) && profileExists(uid)
          && request.resource.data.keys().hasAll(['workoutId', 'title', 'category', 'durationMinutes', 'completedAt'])
          && request.resource.data.keys().hasOnly(['workoutId', 'title', 'category', 'durationMinutes', 'completedAt'])
          && request.resource.data.workoutId is string
          && request.resource.data.workoutId.size() > 0 && request.resource.data.workoutId.size() <= 100
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
          && validCategory(request.resource.data.category)
          && request.resource.data.durationMinutes is number
          && request.resource.data.durationMinutes > 0 && request.resource.data.durationMinutes <= 1440
          && request.resource.data.completedAt is timestamp
          && request.resource.data.completedAt == request.time;
        allow update, delete: if false;
      }
      match /weightHistory/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) && profileExists(uid)
          && request.resource.data.keys().hasAll(['weight', 'recordedAt'])
          && request.resource.data.keys().hasOnly(['weight', 'recordedAt'])
          && request.resource.data.weight is number
          && request.resource.data.weight >= 20 && request.resource.data.weight <= 400
          && request.resource.data.recordedAt is timestamp
          && request.resource.data.recordedAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}

