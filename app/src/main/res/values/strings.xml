    <string name="app_name">FIT</string>
    <string name="fit_text_001">Атыңызды 2–60 таңбамен енгізіңіз</string>
    <string name="fit_text_002">Электрондық пошта мекенжайын дұрыс енгізіңіз</string>
    <string name="fit_text_003">Құпиясөз кемінде 6 таңбадан тұруы керек</string>
    <string name="fit_text_004">Құпиясөздер сәйкес келмейді</string>
    <string name="fit_text_006">Тіркелгі жасаңыз</string>
    <string name="fit_text_008">Қызмет әлі қосылмаған. Әзірге тіркелгіге кіру және деректерді сақтау мүмкін емес.</string>
    <string name="fit_text_009">Аты</string>
    <string name="fit_text_010">Электрондық пошта</string>
    <string name="fit_text_011">Құпиясөз</string>
    <string name="fit_text_012">Жасыру</string>
    <string name="fit_text_013">Көрсету</string>
    <string name="fit_text_014">Құпиясөзді қайталаңыз</string>
    <string name="fit_text_015">Тіркелу</string>
    <string name="fit_text_016">Кіру</string>
    <string name="fit_text_017">Тіркелгіңіз бар ма? Кіру</string>
    <string name="fit_text_018">Тіркелгі жасау</string>
    <string name="fit_text_019">Қалпына келтіру үшін электрондық поштаңызды енгізіңіз</string>
    <string name="fit_text_020">Құпиясөзді қалпына келтіру</string>
    <string name="fit_text_021">Жаттығулар каталогын қарау</string>
    <string name="fit_text_022">Күн сайын шыныға түс</string>
    <string name="fit_text_025">Алғашқы қадамың</string>
    <string name="fit_text_026">Алғашқы жаттығуды баста — жетістіктерің осы жерде көрсетіледі.</string>
    <string name="fit_text_029">Жаттығуды бастау</string>
    <string name="fit_text_030">Барлығы</string>
    <string name="fit_text_031">Жаттығулар</string>
    <string name="fit_text_033">Атауы бойынша іздеу</string>
    <string name="fit_text_034">Бастапқы деңгей</string>
    <string name="fit_text_035">Орта деңгей</string>
    <string name="fit_text_036">Ештеңе табылмады. Іздеу сөзін немесе сүзгілерді өзгертіңіз.</string>
    <string name="fit_text_037">Алдымен жеңіл қыздырыныңыз. Тәсілдер арасында 30–60 секунд демалыңыз. Ауырсыну сезілсе, тоқтаңыз.</string>
    <string name="fit_text_038">Жаттығуды бастап, нәтижесін сақтау үшін тіркелгіге кіріңіз.</string>
    <string name="fit_text_039">Жаттығудан шығасыз ба?</string>
    <string name="fit_text_040">Аяқталмаған жаттығу тарихқа сақталмайды.</string>
    <string name="fit_text_041">Шығу</string>
    <string name="fit_text_042">Жалғастыру</string>
    <string name="fit_text_043">Қазір аяқтайсыз ба?</string>
    <string name="fit_text_044">Жаттығудың нақты ұзақтығы тарихқа жазылады.</string>
    <string name="fit_text_045">Сақтау</string>
    <string name="fit_text_046">Жаттығу барысы</string>
    <string name="fit_text_047">Өзіңізге ыңғайлы қарқынмен орындаңыз. Тәсілдер арасында демалыңыз.</string>
    <string name="fit_text_048">Тәсіл орындалды</string>
    <string name="fit_text_049">Келесі жаттығу</string>
    <string name="fit_text_050">Жаттығуды аяқтау</string>
    <string name="fit_text_051">Сақтамай шығу</string>
    <string name="fit_text_052">фунт</string>
    <string name="fit_text_053">кг</string>
    <string name="fit_text_054">Жетістіктер</string>
    <string name="fit_text_055">Соңғы 7 күндегі белсенділік</string>
    <string name="fit_text_056">10 жаттығу — қозғалыс әдетке айналды!</string>
    <string name="fit_text_057">Алғашқы жаттығу аяқталды! Келесі мақсат — 10 жаттығу.</string>
    <string name="fit_text_058">Алғашқы жетістікке қадам жаса: жаттығуды аяқта.</string>
    <string name="fit_text_059">Рұқсат етілген салмақ: 20–400 кг немесе фунтпен есептелген баламасы</string>
    <string name="fit_text_060">Салмақты жазу</string>
    <string name="fit_text_061">Салмағыңызды алғаш рет жазыңыз — осы жерде график пайда болады.</string>
    <string name="fit_text_062">Жаттығулар тарихы</string>
    <string name="fit_text_063">Әзірге аяқталған жаттығулар жоқ.</string>
    <string name="fit_text_064">Профиль</string>
    <string name="fit_text_065">Профиль әзірге қолжетімсіз. Интернет байланысын және дерекқордың рұқсаттарын тексеріңіз.</string>
    <string name="fit_text_066">Кіру бетіне оралу</string>
    <string name="fit_text_067">Жас</string>
    <string name="fit_text_068">Бой, см</string>
    <string name="fit_text_069">Салмақ, фунт</string>
    <string name="fit_text_070">Салмақ, кг</string>
    <string name="fit_text_071">Деректерді тексеріңіз: аты 2–60 таңба, жасы 14–100, бойы 100–250 см, салмағы 20–400 кг</string>
    <string name="fit_text_072">Баптаулар және шығу</string>
    <string name="fit_text_073">Тіркелгіден шығасыз ба?</string>
    <string name="fit_text_074">Бас тарту</string>
    <string name="fit_text_075">Басты бет</string>
    <string name="fit_text_076">← Артқа</string>
    <string name="fit_text_077">Өз ырғағың. Өз жетістігің.</string>
    <string name="fit_text_078">Жарайсың!</string>
    <string name="fit_text_079">Жаттығу дерекқорға сақталды. Мақсатыңа тағы бір қадам жақындадың.</string>
    <string name="fit_text_080">Жетістіктерді көру</string>
    <string name="fit_text_081">Басты бетке</string>
    <string name="fit_text_082">Баптаулар</string>
    <string name="fit_text_083">Жеке фитнес күнделігі: жаттығулар, белсенділік пен жетістіктер бір жерде.</string>
    <string name="fit_text_084">Салмақ өлшем бірліктері</string>
    <string name="fit_text_085">Килограмм</string>
    <string name="fit_text_086">Фунт</string>
    <string name="fit_text_087">Дерекқорда салмақ әрдайым килограммен сақталады. Көрсету мен енгізу кезінде таңдалған өлшем бірлігі ескеріледі.</string>
    <string name="fit_text_088">Безендіру: FIT • қара және лайм түстері</string>
    <string name="fit_text_089">Тіркелгіден шығу</string>
